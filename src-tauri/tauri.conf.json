{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-off-remote",
  "version": "0.1.0",
  "identifier": "com.boris.my-off-remote",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/my-off-remote/browser"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "my-off-remote",
        "width": 380,
        "height": 475,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp"
      }
    },
    "resources": [
      "assets/index.html",
      "assets/remote.jpg",
      "assets/icon.png"
    ]
  }
}
