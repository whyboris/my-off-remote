{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-off-remote",
  "version": "0.1.0",
  "identifier": "com.boris.my-off-remote",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/my-off-remote/browser"
  },
  "app": {
    "windows": [
      {
        "title": "my-off-remote",
        "width": 400,
        "height": 500,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/lol.html"
    ]
  }
}
